{
  "name": "revelation",
  "version": "1.0.13",
  "dependencies": {
    "chart.js": "^4.5.1",
    "chokidar": "^5.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "highlight.js": "^11.12.0",
    "js-yaml": "^5.4.2",
    "marked": "^18.0.5",
    "reveal.js": "^6.0.2",
    "reveal.js-appearance": "^1.4.1",
    "reveal.js-plugins": "^4.6.0",
    "reveal.js-remote": "github:fiforms/reveal.js-remote",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vite": "^8.0.16"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail npm:watch:theme npm:vite",
    "vite": "vite",
    "vite:serve": "vite --host",
    "relay": "REVELATION_PUBLIC_SERVER=1 vite --host",
    "watch:theme": "sass --watch css/source:css --silence-deprecation import --load-path=node_modules --load-path=node_modules/reveal.js/css/theme",
    "build:theme": "sass css/source:dist/css --silence-deprecation import --load-path=node_modules --load-path=node_modules/reveal.js/css/theme",
    "build:fonts": "node scripts/copy-fonts.js",
    "build": "npm run vite:build && npm run build:theme && npm run build:fonts",
    "vite:build": "vite build",
    "make": "node scripts/make-presentation.js",
    "addimages": "node scripts/add-images.mjs",
    "postinstall": "node scripts/init-presentations.js && node scripts/fetch-oldcss.js --soft",
    "fetch-oldcss": "node scripts/fetch-oldcss.js",
    "init-presentations": "node scripts/init-presentations.js",
    "serve": "concurrently --kill-others-on-fail npm:watch:theme npm:vite:serve",
    "tests": "node tests/run-tests.cjs",
    "tests:fixtures": "node tests/run-tests.cjs --fixtures-only",
    "tests:generate": "node tests/run-tests.cjs --generate"
  },
  "overrides": {
    "reveal.js-plugins": {
      "npm": "npm:noop2@2.0.0"
    },
    "shell-quote": "^1.12.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "sass": "^1.101.0"
  }
}
